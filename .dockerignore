# Root build context only. Each Compose build has its own .dockerignore.

# Credentials and local deployment configuration never belong in images.
**/.env*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/id_rsa
**/id_ed25519
compose.override.yml
compose.override.yaml
docker-compose.override.yml
docker-compose.override.yaml

# Repository, CI, agent, documentation, and local editor metadata.
**/.git
**/.github
**/.codex
**/*.md
**/.vscode
**/.idea
**/.history

# Dependency installations, virtual environments, caches, and audit output.
**/node_modules
**/.pnpm-store
**/.npm
**/.yarn/cache
**/.yarn/unplugged
**/__pycache__
**/*.py[cod]
**/.venv
**/venv
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage*
**/htmlcov
security-reports
gitleaks-report.*
trivy-results.*
bandit-report.*

# Runtime state belongs in host mounts or Docker volumes, outside build context.
portracker-data
homarr
nginx-proxy-manager
qbittorrent
sonarr
radarr
bazarr
jellyseerr
seerr
prowlarr
tdarr
open-webui
nextcloud
searxng
n8n
unbound
etc-pihole
excalidraw-*
rustdesk
archivist
stirling
uptime-kuma
adguard
data
models
output
subtitle-worker/data
subtitle-worker/models
subtitle-worker/output
subtitle-worker/library

**/*.log
**/*.tmp
**/*.swp
**/*.swo
**/*~
**/.DS_Store
**/._*
**/Thumbs.db
**/[Dd]esktop.ini
