# Native CUDA inference; source, SDK, models and Rust dependencies are pinned.
FROM scratch AS native-source-cache
FROM nvidia/cuda:12.8.1-devel-ubuntu22.04@sha256:a99a1860ba8e2916e5c3e73b72ec4c4301653a84586e05bfc9a2aa2d58027e97 AS cuda-sdk
FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04@sha256:4a801ef9232d2b05e69df4eb8aa054dbbe2824e5499e1e6e857320bb01ac41a9 AS cuda-runtime

FROM rust:1.99.0-slim-bookworm@sha256:2c3a22f0a5533ea2dd5a16627bc841228151faa2d4de2644ac9987e4a2f1f2fa AS native-tools
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl clang libclang-dev cmake pkg-config g++ make nasm \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=type=bind,from=native-source-cache,target=/native-source-cache \
    if [ -f /native-source-cache/mnn-6b1db4c2eacf8193e6b7a1841acb6e31a1938e82.tar.gz ]; then \
      cp /native-source-cache/mnn-6b1db4c2eacf8193e6b7a1841acb6e31a1938e82.tar.gz /tmp/mnn.tar.gz; \
    else curl --fail --location --retry 3 \
      https://codeload.github.com/alibaba/MNN/tar.gz/6b1db4c2eacf8193e6b7a1841acb6e31a1938e82 \
      --output /tmp/mnn.tar.gz; fi \
    && echo 'b22142b69082b2720eb4a86598d4d189cd6f44aeca28fc8d7f23ca34345b81c0  /tmp/mnn.tar.gz' | sha256sum --check --strict \
    && mkdir /opt/mnn \
    && tar -xzf /tmp/mnn.tar.gz --strip-components=1 -C /opt/mnn \
    && rm /tmp/mnn.tar.gz
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && rustup component add clippy
COPY --from=cuda-sdk /usr/local/cuda-12.8 /usr/local/cuda
ENV MNN_SOURCE_DIR=/opt/mnn \
    CUDA_HOME=/usr/local/cuda \
    CUDACXX=/usr/local/cuda/bin/nvcc \
    PATH=/usr/local/cuda/bin:$PATH \
    CMAKE_BUILD_PARALLEL_LEVEL=2 \
    CARGO_BUILD_JOBS=1

FROM native-tools AS native-ocr-build
WORKDIR /ocr-build
COPY native-ocr/Cargo.toml native-ocr/Cargo.lock ./
COPY native-ocr/src/ ./src/
COPY native-ocr/models.sha256 ./models.sha256
# Builders have no granted GPU; hardware execution is checked after build.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/ocr-build/cuda-target \
    CARGO_TARGET_DIR=/ocr-build/cuda-target cargo build --release --locked --features cuda \
    && cp cuda-target/release/subforge-ocr /opt/subforge-ocr \
    && mkdir /opt/native-libs \
    && find cuda-target -type f -name 'libMNN_Cuda_Main.so' -exec cp {} /opt/native-libs/ \; \
    && test -s /opt/native-libs/libMNN_Cuda_Main.so

FROM rust:1.99.0-slim-bookworm@sha256:2c3a22f0a5533ea2dd5a16627bc841228151faa2d4de2644ac9987e4a2f1f2fa AS cuda-build
WORKDIR /build
ENV CARGO_BUILD_JOBS=1
COPY Cargo.toml Cargo.lock ./
COPY src/ ./src/
COPY web/ ./web/
COPY tests/ ./tests/
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/target \
    cargo test --locked --features cuda \
    && cargo build --release --locked --features cuda \
    && cargo build --release --locked --features cuda,smoke-tests --bin subforge-smoke \
    && cp target/release/subforge /build/subforge \
    && cp target/release/subforge-worker /build/subforge-worker \
    && cp target/release/subforge-smoke /build/subforge-smoke

FROM homelab-subtitle-converter:0.4.4-cpu AS cuda-runtime-app
USER root
COPY --from=native-ocr-build /opt/subforge-ocr /usr/local/bin/subforge-ocr
COPY --from=native-ocr-build /opt/native-libs/ /usr/local/lib/
COPY --from=cuda-runtime /usr/local/cuda-12.8/targets/x86_64-linux/lib/libcudart.so* /usr/local/lib/
COPY --from=cuda-runtime /usr/local/cuda-12.8/targets/x86_64-linux/lib/libcublas.so* /usr/local/lib/
COPY --from=cuda-runtime /usr/local/cuda-12.8/targets/x86_64-linux/lib/libcublasLt.so* /usr/local/lib/
COPY --from=cuda-build /build/subforge /usr/local/bin/subforge
COPY --from=cuda-build /build/subforge-worker /usr/local/bin/subforge-worker
RUN cp /usr/local/bin/subforge-ocr /usr/local/bin/paddleocr \
    && chmod 0555 /usr/local/bin/subforge-ocr /usr/local/bin/paddleocr \
    && ldconfig
LABEL org.opencontainers.image.version="0.4.4" \
      io.subforge.edition="cuda"
USER 1000:1000
ENV CONVERTER_ENABLE_GPU=true \
    CONVERTER_ENABLE_OCR=true \
    LD_LIBRARY_PATH=/usr/local/lib:/usr/lib/wsl/lib:/usr/local/nvidia/lib64

FROM cuda-runtime-app AS test
COPY --from=cuda-build /build/subforge-smoke /usr/local/bin/subforge-smoke

FROM cuda-runtime-app AS final
