# Example values only. Keep deployment addresses and credentials in the ignored .env.

# Host and browser service addresses (local, LAN, or reverse-proxy URLs)
TZ=Etc/UTC
HOMELAB_URL=http://localhost
GLANCE_PUBLIC_URL=http://localhost:7575
JELLYFIN_PUBLIC_URL=http://localhost:8096
OPEN_WEBUI_PUBLIC_URL=http://localhost:3001
NEXTCLOUD_PUBLIC_URL=http://localhost:11000
IT_TOOLS_PUBLIC_URL=http://localhost:8888
N8N_PUBLIC_URL=http://localhost:5678
TUBEARCHIVIST_PUBLIC_URL=http://localhost:8000
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/

# Private credentials; populate only in the ignored .env file
# Cloudflare tunnel credential
CLOUDFLARE_TUNNEL_TOKEN=
# Cloudflare API credential for DNS updates
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DDNS_DOMAINS=
# Jellyfin server API credential
JELLYFIN_API_KEY=
# Sonarr server API credential
SONARR_API_KEY=
# Radarr server API credential
RADARR_API_KEY=
# Seerr server API credential
SEERR_API_KEY=
# TubeArchivist account name
YT_TA_USERNAME=
# TubeArchivist account password
YT_TA_PASSWORD=
# TubeArchivist Elasticsearch password
YT_ELASTIC_PASSWORD=

# Docker API proxies; adapt the daemon-side paths for a nondefault Docker data root
DOCKER_SOCKET_SOURCE=/var/run/docker.sock
# Numeric daemon socket group as seen inside the proxy; Desktop commonly uses 0.
DOCKER_SOCKET_GID=0
AIO_PROXY_SOCKET_PATH=/var/lib/docker/volumes/nextcloud_aio_docker_socket/_data/docker.sock
GLANCE_DOCKER_HOST=tcp://docker-proxy:2375

# Internal service base URLs (no trailing slash)
JELLYFIN_INTERNAL_URL=http://host.docker.internal:8096
SONARR_INTERNAL_URL=http://sonarr:8989
RADARR_INTERNAL_URL=http://radarr:7878
SEERR_INTERNAL_URL=http://seerr:5055
QBITTORRENT_INTERNAL_URL=http://qbittorrent:8080
GLANCE_INTERNAL_URL=http://glance:8080
GLANCE_PROWLARR_INTERNAL_URL=http://prowlarr:9696
GLANCE_METUBE_INTERNAL_URL=http://metube:8081
GLANCE_TUBEARCHIVIST_INTERNAL_URL=http://tubearchivist:8000
GLANCE_TDARR_INTERNAL_URL=http://tdarr:8265
GLANCE_BAZARR_INTERNAL_URL=http://bazarr:6767
GLANCE_SUBTITLE_STUDIO_INTERNAL_URL=http://subtitle-worker:8099
GLANCE_ADGUARD_INTERNAL_URL=http://adguardhome:80
GLANCE_NGINX_PROXY_MANAGER_INTERNAL_URL=http://nginx-proxy-manager:81
GLANCE_UPTIME_KUMA_INTERNAL_URL=http://uptime-kuma:3001
GLANCE_PORTRACKER_INTERNAL_URL=http://portracker:4999
GLANCE_OPEN_WEBUI_INTERNAL_URL=http://open-webui:8080
GLANCE_IT_TOOLS_INTERNAL_URL=http://it-tools:80
GLANCE_N8N_INTERNAL_URL=http://n8n:5678
GLANCE_STIRLING_PDF_INTERNAL_URL=http://stirling-pdf:8080
GLANCE_SEARXNG_INTERNAL_URL=http://searxng:8080
GLANCE_JELLYFIN_COUNTS_INTERNAL_URL=http://jellyfin-counts-cache:8765

# Glance appearance
GLANCE_APP_NAME=Homelab
GLANCE_LOGO_TEXT=HL
GLANCE_WEATHER_LOCATION=London, United Kingdom

# Public external bookmarks and search providers (safe project defaults)
GLANCE_YOUTUBE_URL=https://www.youtube.com
GLANCE_GITHUB_URL=https://github.com
GLANCE_REDDIT_URL=https://www.reddit.com
GLANCE_STEAM_URL=https://store.steampowered.com
GLANCE_EPIC_GAMES_URL=https://store.epicgames.com
GLANCE_GOG_URL=https://www.gog.com
GLANCE_PROTONDB_URL=https://www.protondb.com
GLANCE_CLOUDFLARE_DASHBOARD_URL=https://one.dash.cloudflare.com
GLANCE_DOCKER_HUB_URL=https://hub.docker.com
GLANCE_STACK_OVERFLOW_URL=https://stackoverflow.com
GLANCE_CHATGPT_URL=https://chatgpt.com
GLANCE_HUGGING_FACE_URL=https://huggingface.co
GLANCE_COMMUNITY_WIDGETS_REGISTRY_URL=https://raw.githubusercontent.com/glanceapp/community-widgets/refs/heads/main/registry/widgets.json

# Glance public RSS feed sources
GLANCE_BLEEPINGCOMPUTER_FEED_URL=https://www.bleepingcomputer.com/feed/
GLANCE_KREBS_FEED_URL=https://krebsonsecurity.com/feed/
GLANCE_SCHNEIER_FEED_URL=https://www.schneier.com/feed/atom/
GLANCE_ARS_TECHNICA_FEED_URL=https://feeds.arstechnica.com/arstechnica/index
GLANCE_REGISTER_FEED_URL=https://www.theregister.com/headlines.atom
GLANCE_SELFH_FEED_URL=https://selfh.st/rss/
GLANCE_PHORONIX_FEED_URL=https://www.phoronix.com/rss.php
GLANCE_HUGGING_FACE_FEED_URL=https://huggingface.co/blog/feed.xml

# Media paths: example Windows values; choose absolute macOS/Linux paths for your host
EXAMPLE_MEDIA_ROOT=
SUBTITLE_MEDIA_DIR=D:/homelab-subtitles
SUBTITLE_LIBRARY_DIR=D:/homelab-media

# Subtitle models and local inference
SUBTITLE_BIND_ADDRESS=127.0.0.1
WHISPER_MODEL=medium
WHISPER_LOCAL_FILES_ONLY=false
SUBTITLE_LLM_MODEL=
SUBTITLE_REVIEW_MODEL=
SUBTITLE_LLM_BASE_URL=http://host.docker.internal:1234/v1
SUBTITLE_LLM_TIMEOUT=600
