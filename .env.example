NEXTCLOUD_PASSPHRASE=
NEXTCLOUD_ADMIN_USER=
WEBPASSWORD=

TZ=
HOMELAB_URL=

# LAN address while your home proxy is marked Offline
GLANCE_PUBLIC_URL=

GLANCE_BIND_ADDRESS=
JELLYFIN_PUBLIC_URL=
OPEN_WEBUI_PUBLIC_URL=
NEXTCLOUD_PUBLIC_URL=
IT_TOOLS_PUBLIC_URL=
N8N_PUBLIC_URL=

# Private LAN access
TUBEARCHIVIST_PUBLIC_URL=

N8N_HOST=
N8N_WEBHOOK_URL=

# Glance app configuration
GLANCE_APP_NAME=
GLANCE_LOGO_TEXT=
GLANCE_WEATHER_LOCATION=

# Private credentials; populate only in the ignored .env file
# Cloudflare tunnel credential
CLOUDFLARE_TUNNEL_TOKEN=
# Cloudflare API credential for DNS updates
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DDNS_DOMAINS=
# Jellyfin server API credential
JELLYFIN_API_KEY=
# Sonarr server API credential
SONARR_API_KEY=
# Radarr server API credential
RADARR_API_KEY=
# Bazarr API credential for optional Subforge sync and subtitle indexing
BAZARR_API_KEY=
# Seerr server API credential
SEERR_API_KEY=
# TubeArchivist account name
YT_TA_USERNAME=
# TubeArchivist account password
YT_TA_PASSWORD=
# TubeArchivist Elasticsearch password
YT_ELASTIC_PASSWORD=

QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Docker API proxies; adapt the daemon-side paths for a nondefault Docker data root
DOCKER_SOCKET_SOURCE=/var/run/docker.sock
DOCKER_SOCKET_GID=0
AIO_PROXY_SOCKET_PATH=/var/lib/docker/volumes/nextcloud_aio_docker_socket/_data/docker.sock
GLANCE_DOCKER_HOST=tcp://docker-proxy:2375

# Internal service base URLs (no trailing slash)
JELLYFIN_INTERNAL_URL=http://host.docker.internal:8096
SONARR_INTERNAL_URL=http://sonarr:8989
RADARR_INTERNAL_URL=http://radarr:7878
BAZARR_INTERNAL_URL=http://bazarr:6767
SEERR_INTERNAL_URL=http://seerr:5055
QBITTORRENT_INTERNAL_URL=http://qbittorrent:8080
GLANCE_INTERNAL_URL=http://glance:8080
GLANCE_PROWLARR_INTERNAL_URL=http://prowlarr:9696
GLANCE_METUBE_INTERNAL_URL=http://metube:8081
GLANCE_TUBEARCHIVIST_INTERNAL_URL=http://tubearchivist:8000
GLANCE_TDARR_INTERNAL_URL=http://tdarr:8265
GLANCE_BAZARR_INTERNAL_URL=http://bazarr:6767
GLANCE_SUBTITLE_STUDIO_INTERNAL_URL=http://subtitle-studio:8099
GLANCE_SUBFORGE_INTERNAL_URL=http://subforge:8100
GLANCE_ADGUARD_INTERNAL_URL=http://adguardhome:80
GLANCE_NGINX_PROXY_MANAGER_INTERNAL_URL=http://nginx-proxy-manager:81
GLANCE_UPTIME_KUMA_INTERNAL_URL=http://uptime-kuma:3001
GLANCE_PORTRACKER_INTERNAL_URL=http://portracker:4999
GLANCE_OPEN_WEBUI_INTERNAL_URL=http://open-webui:8080
GLANCE_IT_TOOLS_INTERNAL_URL=http://it-tools:80
GLANCE_N8N_INTERNAL_URL=http://n8n:5678
GLANCE_STIRLING_PDF_INTERNAL_URL=http://stirling-pdf:8080
GLANCE_SEARXNG_INTERNAL_URL=http://searxng:8080
GLANCE_JELLYFIN_COUNTS_INTERNAL_URL=http://jellyfin-counts-cache:8765

# Public external bookmarks and search providers (safe project defaults)
GLANCE_YOUTUBE_URL=https://www.youtube.com
GLANCE_GITHUB_URL=https://github.com
GLANCE_REDDIT_URL=https://www.reddit.com
GLANCE_STEAM_URL=https://store.steampowered.com
GLANCE_EPIC_GAMES_URL=https://store.epicgames.com
GLANCE_EPIC_FREE_GAMES_API_URL=https://store-site-backend-static.ak.epicgames.com/freeGamesPromotions?locale=en&country=US&allowCountries=US
GLANCE_GOG_URL=https://www.gog.com
GLANCE_PROTONDB_URL=https://www.protondb.com
GLANCE_CLOUDFLARE_DASHBOARD_URL=https://one.dash.cloudflare.com
GLANCE_DOCKER_HUB_URL=https://hub.docker.com
GLANCE_STACK_OVERFLOW_URL=https://stackoverflow.com
GLANCE_CHATGPT_URL=https://chatgpt.com
GLANCE_HUGGING_FACE_URL=https://huggingface.co
GLANCE_COMMUNITY_WIDGETS_REGISTRY_URL=https://raw.githubusercontent.com/glanceapp/community-widgets/refs/heads/main/registry/widgets.json

# Glance public RSS feed sources
GLANCE_BLEEPINGCOMPUTER_FEED_URL=https://www.bleepingcomputer.com/feed/
GLANCE_KREBS_FEED_URL=https://krebsonsecurity.com/feed/
GLANCE_SCHNEIER_FEED_URL=https://www.schneier.com/feed/atom/
GLANCE_ARS_TECHNICA_FEED_URL=https://feeds.arstechnica.com/arstechnica/index
GLANCE_REGISTER_FEED_URL=https://www.theregister.com/headlines.atom
GLANCE_SELFH_FEED_URL=https://selfh.st/rss/
GLANCE_PHORONIX_FEED_URL=https://www.phoronix.com/rss.php
GLANCE_HUGGING_FACE_FEED_URL=https://huggingface.co/blog/feed.xml

# Rust gateway ceilings: memory is a maximum, not reserved or expected usage.
GLANCE_LIVE_MEMORY_LIMIT=96m
GLANCE_LIVE_CPUS=0.50
# Maximum active SSE streams; total accepted HTTP sockets are separately bounded.
GLANCE_LIVE_MAX_CONNECTIONS=64
GLANCE_LIVE_MAX_HTTP_CONNECTIONS=128
GLANCE_LIVE_SSE_MAX_SECONDS=900
# Provider and shared snapshot byte caps; exceeding a cap marks the topic stale.
GLANCE_LIVE_MAX_PROVIDER_BYTES=2097152
GLANCE_LIVE_MAX_SNAPSHOT_BYTES=262144
# Missing-media library reads and output have separate byte caps; exceeding either fails the widget.
GLANCE_LIVE_MISSING_MAX_PROVIDER_BYTES=8388608
GLANCE_LIVE_MISSING_MAX_SNAPSHOT_BYTES=2097152
GLANCE_LIVE_MAX_TORRENTS=2000
GLANCE_LIVE_MAX_SESSIONS=256

# Live dashboard updates; intervals in seconds, collected only while a page is visible.
GLANCE_LIVE_QBITTORRENT_INTERVAL=2
GLANCE_LIVE_JELLYFIN_INTERVAL=5
GLANCE_LIVE_JELLYFIN_WS=true

# Additional LAN browser hostnames; Compose also permits GLANCE_BIND_ADDRESS.
GLANCE_LIVE_ALLOWED_HOSTS=localhost,127.0.0.1

# Media paths: example Windows values; choose absolute macOS/Linux paths for your host
SUBTITLE_MEDIA_DIR=D:/subtitles
SUBTITLE_LIBRARY_DIR=D:/

# Allowed HTTP Host names/IPs; include the name or IP used by remote clients.
SUBTITLE_ALLOWED_HOSTS=localhost,127.0.0.1,::1,subtitle-worker,subtitle-studio
# Subtitle models and local inference
SUBTITLE_BIND_ADDRESS=
SUBTITLE_PORT=8099
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_LOCAL_FILES_ONLY=true
SUBTITLE_MODEL_DOWNLOAD_TIMEOUT=3600
SUBTITLE_CUDA_ARCHITECTURES=86
SUBTITLE_STUDIO_MEMORY_LIMIT=6g
SUBTITLE_STUDIO_CPUS=2
WHISPER_CLI=whisper-cli
SUBTITLE_CPU_THREADS=2
SUBTITLE_AUDIO_CHUNK_SECONDS=300
SUBTITLE_PROCESS_TIMEOUT=3600
SUBTITLE_MAX_JOBS=500
SUBTITLE_MAX_QUEUE=32
SUBTITLE_MAX_CLIENTS=16
SUBTITLE_MAX_STREAMS=8
SUBTITLE_MAX_JSON_BYTES=16777216
SUBTITLE_LLM_MODEL=google/gemma-4-e4b
SUBTITLE_REVIEW_MODEL=google/gemma-4-e4b
SUBTITLE_LLM_BASE_URL=http://host.docker.internal:1234/v1
SUBTITLE_LLM_TIMEOUT=600

# Automatic subtitle conversion (opt-in subtitle-converter service)
SUBFORGE_PUBLIC_URL==
CONVERTER_BIND_ADDRESS=
CONVERTER_ALLOWED_HOSTS=localhost,127.0.0.1,::1,subtitle-converter,subforge
CONVERTER_AUTH_ENABLED=false
# Username admin. Blank generates a private password in the converter data volume.
CONVERTER_UI_PASSWORD=
# Required for Sonarr/Radarr incoming webhooks; blank disables hooks.
CONVERTER_WEBHOOK_TOKEN=
# Jellyfin connection reuses JELLYFIN_INTERNAL_URL and JELLYFIN_API_KEY above.
CONVERTER_WIDGET_TOKEN=
# Optional shared credential for remote workers; blank disables registration.
CONVERTER_WORKER_TOKEN=
# Automatic subtitle conversion (opt-in subtitle-converter service)
CONVERTER_MOVIES_DIR=D:/film
CONVERTER_TV_DIR=D:/tv show
CONVERTER_CPU_LIMIT=4
CONVERTER_GPU_MEMORY_LIMIT=3g
CONVERTER_SCAN_INTERVAL=21600
CONVERTER_MIN_AGE=120
CONVERTER_TIMEOUT=7200
CONVERTER_RETRY_INTERVAL=3600
# OCR is opt-in to protect memory; allow 1536m when OCR is enabled.
CONVERTER_ENABLE_OCR=true
CONVERTER_MEMORY_LIMIT=1536m
# Tesseract fallback for image tracks without a recognized language tag.
CONVERTER_OCR_LANGUAGE=eng

# Disable Subforge dashboard login for this deployment.
CONVERTER_AUTH_ENABLED=false
